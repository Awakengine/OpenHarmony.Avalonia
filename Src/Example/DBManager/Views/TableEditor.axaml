<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="DBManager.Views.TableEditor">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Name="RefreshButton" Content="刷新" Margin="0 0 5 0"/>
            <Button Name="AddRowButton" Content="添加行" Margin="0 0 5 0"/>
            <Button Name="DeleteRowButton" Content="删除行" Margin="0 0 5 0"/>
            <Button Name="SaveChangesButton" Content="保存更改" Margin="0 0 5 0"/>
            <Button Name="CancelChangesButton" Content="取消更改"/>
        </StackPanel>
        
        <DataGrid Name="TableDataGrid" 
                  AutoGenerateColumns="True" 
                  DockPanel.Dock="Top"
                  Margin="0 5 0 0"/>
    </DockPanel>
</UserControl>